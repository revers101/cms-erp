NODE_ENV=development
CMS_ERP_ORIGIN=http://127.0.0.1:3000
CMS_ERP_DATABASE=./var/cms-erp.sqlite
CMS_ERP_BOOTSTRAP_EMAIL=admin@example.test
CMS_ERP_BOOTSTRAP_PASSWORD=replace-with-a-long-unique-password
CMS_ERP_TIMEZONE=Europe/Amsterdam
# Optional MFA at-rest encryption key: 32 random bytes encoded as 64 hex characters; store privately.
CMS_ERP_MFA_ENCRYPTION_KEY=
PORT=3000
CMS_ERP_HOST=127.0.0.1
# Optional password-reset mail. Configure both values in the private runtime.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
AUTH0_ISSUER=
AUTH0_AUDIENCE=
AUTH0_ORGANIZATION_ID=
# Optional; defaults to the Auth0 issuer's /.well-known/jwks.json
AUTH0_JWKS_URL=
